option(RGSML_BUILD_TESTS "Build the RGS MasterLab test suite" ON)
option(RGSML_WARNINGS_AS_ERRORS "Treat first-party RGSML warnings as errors" ON)

set(RGSML_PROVENANCE_TYPE "DEV" CACHE STRING "Build provenance type: FQ, PR, CI, or DEV")
set(RGSML_PROVENANCE_PR_NUMBER "" CACHE STRING "Pull request number for PR builds")
set(RGSML_PROVENANCE_RUN_NUMBER "" CACHE STRING "Workflow run number for CI/FQ builds")
set(RGSML_PROVENANCE_GIT_SHA "" CACHE STRING "Git commit SHA")

if(NOT RGSML_PROVENANCE_GIT_SHA)
    find_package(Git QUIET)
    if(GIT_FOUND)
        execute_process(
            COMMAND ${GIT_EXECUTABLE} rev-parse --short=7 HEAD
            WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
            OUTPUT_VARIABLE RGSML_DETECTED_SHA
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )
        set(RGSML_PROVENANCE_GIT_SHA "${RGSML_DETECTED_SHA}")
    endif()
endif()

string(LENGTH "${RGSML_PROVENANCE_GIT_SHA}" RGSML_SHA_LEN)
if(RGSML_SHA_LEN GREATER_EQUAL 7)
    string(SUBSTRING "${RGSML_PROVENANCE_GIT_SHA}" 0 7 RGSML_SHORT_SHA)
else()
    set(RGSML_SHORT_SHA "${RGSML_PROVENANCE_GIT_SHA}")
endif()

if(RGSML_PROVENANCE_TYPE STREQUAL "FQ")
    if(RGSML_PROVENANCE_RUN_NUMBER AND RGSML_SHORT_SHA)
        set(RGSML_BUILD_PROVENANCE "FQ #${RGSML_PROVENANCE_RUN_NUMBER} · ${RGSML_SHORT_SHA}")
    elseif(RGSML_SHORT_SHA)
        set(RGSML_BUILD_PROVENANCE "FQ · ${RGSML_SHORT_SHA}")
    else()
        set(RGSML_BUILD_PROVENANCE "FQ")
    endif()
elseif(RGSML_PROVENANCE_TYPE STREQUAL "PR")
    if(RGSML_PROVENANCE_PR_NUMBER AND RGSML_PROVENANCE_RUN_NUMBER AND RGSML_SHORT_SHA)
        set(RGSML_BUILD_PROVENANCE "PR #${RGSML_PROVENANCE_PR_NUMBER} · CI #${RGSML_PROVENANCE_RUN_NUMBER} · ${RGSML_SHORT_SHA}")
    elseif(RGSML_PROVENANCE_RUN_NUMBER AND RGSML_SHORT_SHA)
        set(RGSML_BUILD_PROVENANCE "CI #${RGSML_PROVENANCE_RUN_NUMBER} · ${RGSML_SHORT_SHA}")
    elseif(RGSML_SHORT_SHA)
        set(RGSML_BUILD_PROVENANCE "PR · ${RGSML_SHORT_SHA}")
    else()
        set(RGSML_BUILD_PROVENANCE "PR")
    endif()
elseif(RGSML_PROVENANCE_TYPE STREQUAL "CI")
    if(RGSML_PROVENANCE_RUN_NUMBER AND RGSML_SHORT_SHA)
        set(RGSML_BUILD_PROVENANCE "CI #${RGSML_PROVENANCE_RUN_NUMBER} · ${RGSML_SHORT_SHA}")
    elseif(RGSML_SHORT_SHA)
        set(RGSML_BUILD_PROVENANCE "CI · ${RGSML_SHORT_SHA}")
    else()
        set(RGSML_BUILD_PROVENANCE "CI")
    endif()
else()
    if(RGSML_SHORT_SHA)
        set(RGSML_BUILD_PROVENANCE "DEV · ${RGSML_SHORT_SHA}")
    else()
        set(RGSML_BUILD_PROVENANCE "DEV")
    endif()
endif()

add_compile_definitions(RGSML_BUILD_PROVENANCE="${RGSML_BUILD_PROVENANCE}")
