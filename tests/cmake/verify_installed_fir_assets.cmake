# One reusable actual installed-16-FIR gate: called from FQ Debug deploy smoke
# and from both Windows/Linux Focused package regression.
# _fir_root is the exact installed flat bin/resources/fir directory.
cmake_policy(PUSH)
cmake_policy(SET CMP0057 NEW)
if(NOT DEFINED _fir_root OR NOT IS_DIRECTORY "${_fir_root}")
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_ROOT_MISSING")
endif()
set(_inventory "${_fir_root}/fir_manifest.json")
if(NOT EXISTS "${_inventory}")
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_MANIFEST_MISSING")
endif()
file(READ "${_inventory}" _fir_manifest)
string(JSON _schema GET "${_fir_manifest}" schema)
if(NOT _schema STREQUAL "rgsml.external-src-fir-assets/2")
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_SCHEMA_INVALID")
endif()
string(JSON _declared_root GET "${_fir_manifest}" installationRoot)
if(NOT _declared_root STREQUAL "resources/fir")
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_INSTALL_ROOT_INVALID")
endif()
string(JSON _complete GET "${_fir_manifest}" complete16FilePackage)
string(JSON _authorized GET "${_fir_manifest}" publicOriginalFirDistributionAuthorized)
string(JSON _included GET "${_fir_manifest}" finalSrc includedInPublicBuild)
if(NOT _complete OR NOT _authorized OR NOT _included)
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_NOT_COMPLETE_AUTHORIZED_REAL_16")
endif()
string(JSON _manifest_assets LENGTH "${_fir_manifest}" assets)
string(JSON _manifest_routes LENGTH "${_fir_manifest}" routes)
if(NOT _manifest_assets EQUAL 16 OR NOT _manifest_routes EQUAL 30)
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_INVENTORY_OR_ROUTES_INVALID")
endif()

# Independently trusted frozen pins, NOT values accepted merely because a
# loose on-disk manifest says so. Read the frozen C++ source oracle in CI.
set(_pins_path "${CMAKE_CURRENT_LIST_DIR}/../../audio/include/rgsml/audio/internal/phase11_frozen_rgsmsr1_pins.hpp")
if(NOT EXISTS "${_pins_path}")
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_TRUSTED_Q0_PIN_SOURCE_MISSING")
endif()
file(READ "${_pins_path}" _pins_source)
set(_known_files)
set(_q0_count 0)
foreach(_i RANGE 0 15)
    string(JSON _name GET "${_fir_manifest}" assets ${_i} file)
    string(JSON _role GET "${_fir_manifest}" assets ${_i} role)
    string(JSON _sha GET "${_fir_manifest}" assets ${_i} sha256)
    string(LENGTH "${_sha}" _digest_len)
    if(NOT _digest_len EQUAL 64 OR NOT _sha MATCHES "^[0-9a-f]+$"
       OR _name IN_LIST _known_files OR _name MATCHES "[/\\\\]")
        message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_BAD_ASSET_IDENTITY")
    endif()
    list(APPEND _known_files "${_name}")
    set(_file "${_fir_root}/${_name}")
    if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}" OR IS_SYMLINK "${_file}")
        message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_BINARY_MISSING_OR_LINK: ${_name}")
    endif()
    file(SHA256 "${_file}" _actual)
    if(NOT _actual STREQUAL _sha)
        message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_BINARY_SHA_MISMATCH: ${_name}")
    endif()
    if(_i LESS 2)
        if(NOT _role STREQUAL "PLAYBACK_FROZEN")
            message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_PLAYBACK_ROLE_CHANGED")
        endif()
        if(_i EQUAL 0)
            set(_frozen_name "playback_src_kernel_44100_48000.bin")
            set(_frozen_sha "ec8c4d554eb4ede15f58eead1fede923e74c4692c57832bda716e3fc826926b4")
        else()
            set(_frozen_name "playback_src_kernel_48000_44100.bin")
            set(_frozen_sha "37cfda8e885e2d00646ec60d02bdf5b7dcb85348fca416e065bab71a824efb22")
        endif()
        if(NOT _name STREQUAL _frozen_name OR NOT _sha STREQUAL _frozen_sha)
            message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_FROZEN_PLAYBACK_PIN_CHANGED")
        endif()
    else()
        string(JSON _packaged GET "${_fir_manifest}" assets ${_i} packaged)
        if(NOT _role STREQUAL "FINAL_SRC_Q0_ORIGINAL" OR NOT _packaged)
            message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_ORIGINAL_Q0_ROLE_OR_PACKAGE_INVALID")
        endif()
        if(NOT _name MATCHES "^RGSMSR1_L([0-9]+)_M([0-9]+)[.]bin$")
            message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_ORIGINAL_Q0_NAME_INVALID")
        endif()
        # C++ frozen source uses {L,M,"SHA256"}. Bind ratio AND exact digest.
        set(_trusted_pin "{${CMAKE_MATCH_1},${CMAKE_MATCH_2},\"${_sha}\"}")
        string(FIND "${_pins_source}" "${_trusted_pin}" _pin_index)
        if(_pin_index LESS 0)
            message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_FROZEN_Q0_PIN_CHANGED: ${_name}")
        endif()
        math(EXPR _q0_count "${_q0_count} + 1")
    endif()
endforeach()
if(NOT _q0_count EQUAL 14)
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_ORIGINAL_Q0_COUNT_INVALID")
endif()
# No hidden historical subfolder, stale binary or extra manifest.
file(GLOB _root_entries RELATIVE "${_fir_root}" "${_fir_root}/*")
list(LENGTH _root_entries _entry_count)
if(NOT _entry_count EQUAL 17)
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_NOT_EXACTLY_16_BINARIES_AND_MANIFEST")
endif()
foreach(_entry IN LISTS _root_entries)
    if(NOT _entry STREQUAL "fir_manifest.json" AND NOT _entry IN_LIST _known_files)
        message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_UNEXPECTED_ASSET: ${_entry}")
    endif()
endforeach()
set(_six_rates 44100 48000 88200 96000 176400 192000)
set(_seen_routes)
set(_qualified_device_routes 0)
foreach(_i RANGE 0 29)
    string(JSON _src GET "${_fir_manifest}" routes ${_i} sourceRateHz)
    string(JSON _dst GET "${_fir_manifest}" routes ${_i} targetRateHz)
    string(JSON _file GET "${_fir_manifest}" routes ${_i} kernelFile)
    string(JSON _role GET "${_fir_manifest}" routes ${_i} role)
    string(JSON _device_ok GET "${_fir_manifest}" routes ${_i} devicePlaybackAdmitted)
    set(_route "${_src}_${_dst}")
    if(NOT _src IN_LIST _six_rates OR NOT _dst IN_LIST _six_rates
       OR _src STREQUAL _dst OR NOT _file IN_LIST _known_files
       OR _route IN_LIST _seen_routes)
        message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_ROUTE_IDENTITY_INVALID")
    endif()
    list(APPEND _seen_routes "${_route}")
    if((_src EQUAL 44100 AND _dst EQUAL 48000)
       OR (_src EQUAL 48000 AND _dst EQUAL 44100))
        if(NOT _device_ok OR NOT _role STREQUAL "PLAYBACK_FROZEN"
           OR NOT _file STREQUAL "playback_src_kernel_${_route}.bin")
            message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_HISTORIC_ROUTE_CHANGED")
        endif()
        math(EXPR _qualified_device_routes "${_qualified_device_routes} + 1")
    elseif(_device_ok OR
           NOT _role STREQUAL "Q0_ORIGINAL_PENDING_DEVICE_QUALIFICATION")
        message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_Q0_PREMATURE_DEVICE_ADMISSION")
    endif()
endforeach()
if(NOT _qualified_device_routes EQUAL 2)
    message(FATAL_ERROR "INSTALLED_UNIFIED_FIR_DEVICE_ADMISSION_COUNT_INVALID")
endif()
string(JSON _release GET "${_fir_manifest}" releaseAuthority)
if(_release)
    message(FATAL_ERROR "FIR_Q0_MATH_NOT_PRODUCT_RELEASE_AUTHORITY")
endif()
message(STATUS "INSTALLED_UNIFIED_FIR_REAL_16_TRUSTED_SHA_AND_DEVICE_GATES_PASS")
cmake_policy(POP)
